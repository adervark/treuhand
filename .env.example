# Copy to .env and fill in. Never commit .env.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# AI: DeepSeek via its OpenAI-compatible API
DEEPSEEK_API_KEY=
# Defaults to https://api.deepseek.com when empty
DEEPSEEK_BASE_URL=
# Model id; defaults to deepseek-flash when empty
CLAUSE_MODEL=

# Optional: raises GitHub API rate limits
GITHUB_TOKEN=

# Optional, off by default: 1 posts each finished code-bounty run's verdict as a
# comment on the pull request (edited in place on later runs). Needs
# GITHUB_TOKEN with permission to comment: on a public repository the token's
# owner does not own, a classic personal access token with the public_repo
# scope (fine-grained tokens only reach their own resource owner's repos).
CLAUSE_GITHUB_PR_COMMENTS=

# Optional: seconds between PASSED and automatic payout; defaults to 0
CLAUSE_CONTEST_WINDOW_SECONDS=

# Optional: SQLite file; defaults to data/clause.db
CLAUSE_DB_PATH=

# Optional: how many differently framed AI reviewers judge each page for an
# ai_page_judgement check (1 to 6); defaults to 3. 1 is the single judge.
CLAUSE_JUDGE_PANEL=

# Optional: the Ed25519 private key (PKCS#8 PEM) that signs verification
# receipts; on one line, write newlines as \n. Generate one with
# `openssl genpkey -algorithm ed25519`. When empty, a key is generated on first
# use and kept in verifier-signing-key.pem beside the database (data/ by
# default, owner-only, never committed). Receipts name their key by
# fingerprint, so changing the key leaves older receipts checkable only
# against the old public key.
VERIFIER_SIGNING_KEY=

# Required for real payouts: the emails of the two demo identities, which are
# the PayPal sandbox personal accounts of the payer (who funds contracts) and
# the worker (who is paid). Payouts go to the worker's email; an address with
# no PayPal account leaves the payout UNCLAIMED. pnpm db:seed stops with an
# error if either is empty, unless run as
# `pnpm db:seed --placeholder-identities` (example.com addresses, for local
# runs where no money moves).
DEMO_PAYER_EMAIL=
DEMO_WORKER_EMAIL=

# Read by the code but set by the host, not here (an empty value in .env would
# break them): PORT, the port `next start` listens on (default 3000), and
# RENDER_EXTERNAL_URL, the app's public URL, used as the base for page metadata
# such as the Open Graph image (default http://localhost:$PORT; Render sets it).
#
# Not read from this file: scripts/mcp-server.ts (the stdio MCP relay) takes
# TREUHAND_URL and TREUHAND_TOKEN from the MCP client's own configuration
# (docs/agents.md). Never put an agent token in a committed file.
